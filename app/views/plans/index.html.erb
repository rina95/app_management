<h2>plans</h2>

<div class="gap-3">

	<%= link_to new_plan_path, class: "btn btn-success" do %>
		<i class="bi bi-plus"></i> New plan
	<% end %>

	<div class="search-right">
		<%= search_form_for @search do |f| %>
			<%= f.search_field :title_or_code_or_software_name_or_software_code_cont, class: 'form-control', placeholder: "Search" %>
			<%= button_tag type: 'submit', class: 'btn btn-success' do %>
				<i class="bi bi-search"></i>
			<% end %>
		<% end %>
	</div>

	<%= form_with url: import_plans_path, multipart: true, method: :post, local: true do |form| %>
		<div class="form-group">
			<%= form.file_field :file, accept: ".csv", class: "form-control" %>
		</div>
		<div class="actions">
			<%= form.submit "Import CSV", class: "btn btn-primary" %>
		</div>
	<% end %>

	<% if @plans.length == 0 %>
		<div class="alert alert-warning">No items registered</div>
	<% else %>
		<table class="table table-bordered table-striped">
			<thead>
				<tr class="info">
					<th><%= t "ID" %></th>
					<th><%= t "views.field.software_name" %></th>
					<th><%= t "views.field.code" %></th>
					<th><%= t "views.field.title" %></th>
					<th><%= t "views.field.document_link" %></th>
					<th><%= t "views.field.urgent" %></th>
					<th><%= t "views.field.expect_approval_date" %></th>
					<th><%= t "views.function.title" %></th>
				</tr>
			</thead>
			<tbody>
				<% @plans.each do |plan| %>
					<tr>
						<td><%= plan.id %></td>
						<td><%= plan.software&.name %></td>
						<td><%= plan.code %></td>
						<td><%= plan.title %></td>
						<td>
							<%= link_to "document link", plan.document_link, class: '' %>
						</td>
						<td><%= plan.urgent %></td>
						<td><%= plan.role %></td>
						<td><%= plan.expect_approval_date %></td>
						<td class="text-center">
							<%= link_to plan, class: "btn btn-default" do %>
								<i class="bi bi-eye"></i>
							<% end %>
							<%= link_to edit_plan_path(plan), class: "btn btn-primary" do %>
								<i class="bi bi-pencil"></i>
							<% end %>
							<%= link_to plan, method: :delete, data: { confirm: "Are you sure you want to remove?" }, class: "btn btn-danger" do %>
								<i class="bi bi-trash"></i>
							<% end %>
						</td>
					</tr>
				<% end %>
			</tbody>
		</table>
		<div class="pag-right">
			<%= paginate @plans %>
		</div>
	<% end %>
</div>
