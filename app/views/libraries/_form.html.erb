<%= form_with model: library, local: true do |form| %>
  <%= render "shared/error_messages", resource: library %>

  <div class="form-group">
    <%= form.label :software_id %>
    <%= collection_select(:library, :software_id, Software.all, :id, :name, {}, {class: 'form-control'}) %>
    <%= link_to "Create new software?", new_software_path %><br />
  </div>

  <div class="form-group">
    <%= form.label :software_version %>
    <%= form.text_field :software_version, id: :software_version, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :code %>
    <%= form.text_field :code, id: :library_code, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :title %>
    <%= form.text_field :title, id: :library_title, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :document_link %>
    <%= form.text_field :document_link, id: :library_document_link, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :expect_approval_date %>
    <%= form.date_field :expect_approval_date, id: :library_expect_approval_date, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :app_type %>
    <%= form.select :app_type, options_for_select(Library.app_types.keys.map { |obj| [obj.humanize, obj] }, @library.app_type), {}, {class: 'form-control'} %>
  </div>

  <div class="form-group">
    <%= form.label :app_type_text %>
    <%= form.text_field :app_type_text, id: :library_app_type_text, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :request_type %>
    <%= form.select :request_type, options_for_select(library.request_types.keys.map { |obj| [obj.humanize, obj] }, @library.request_type), {}, {class: 'form-control'} %>
  </div>

  <div class="form-group">
    <%= form.label :contact_user %>
    <%= form.text_field :contact_user, id: :library_contact_user, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :urgent %>
    <%= form.check_box :urgent, id: :library_active %>
  </div>

  <div class="actions">
    <%= link_to librarys_path, class: "btn btn-default" do %>
      <i class="fa fa-arrow-left"></i> Back
    <% end %>
    <%= button_tag type: 'submit', class: 'btn btn-success' do %>
      <i class="fa fa-hdd-o"></i> Save
    <% end %>
  </div>
<% end %>
